{
  "name": "civic",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev:api": "pnpm --filter @civic/api dev",
    "dev:mobile": "pnpm --filter @civic/mobile start",
    "dev:mobile:tunnel": "pnpm --filter @civic/mobile start:tunnel",
    "dev:mobile:lan": "pnpm --filter @civic/mobile start:lan",
    "dev:mobile:ngrok": "pnpm --filter @civic/mobile start:ngrok",
    "ngrok:tunnel": "pnpm --filter @civic/mobile ngrok:tunnel",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "version": "1.0.0",
  "dependencies": {
    "expo": "~54.0.36",
    "react": "19.1.0",
    "react-native": "0.81.5"
  }
}
