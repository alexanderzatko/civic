{
  "name": "civic",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @civic/api dev",
    "dev:mobile": "pnpm --filter @civic/mobile start",
    "dev:mobile:tunnel": "pnpm --filter @civic/mobile start:tunnel",
    "dev:mobile:lan": "pnpm --filter @civic/mobile start:lan",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
