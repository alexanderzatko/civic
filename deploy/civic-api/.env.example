# Civic API — production values for /opt/docker/civic-api/.env on the VPS.
# Copied by deploy.sh only if the remote .env does not already exist.

PORT=3001
HOST=0.0.0.0
DATABASE_PATH=/data/civic.sqlite

HOURLY_WAGE_EUR=7.50
FORMULA_VERSION=1

EKASA_RECEIPT_FIND_URL=https://ekasa.financnasprava.sk/mdu/api/v1/opd/receipt/find

ROVAS_BASE_URL=https://dev.rovas.app
ROVAS_OAUTH_CLIENT_ID=civic
# ROVAS_API_KEY=
# ROVAS_TOKEN=
# GOOGLE_CLIENT_IDS=
# APPLE_CLIENT_IDS=app.civic.mobile

MIN_VAT_EUR=0.01
STRIKE_THRESHOLD=3
STRIKE_WINDOW_DAYS=30
STRIKE_BLOCK_DAYS=7
CLAIM_RATE_LIMIT_DAY=20
CLAIM_RATE_LIMIT_MONTH=200

# Production: enable claim window + same-store daily cap
CLAIM_WINDOW_ENABLED=true
CLAIM_WINDOW_DAYS=1
SAME_STORE_DAILY_LIMIT_ENABLED=true
SAME_STORE_DAILY_LIMIT=2

# Volunteer WR Civic app usage fee (project created on Rovas).
WR_USAGE_FEE_ENABLED=true
WR_USAGE_FEE_RATE=0.03
CIVIC_APP_PROJECT_NID=572604

# Location heuristics deferred (unused)
MAX_GROUND_SPEED_KMH=100
LOCATION_BUFFER_KM=25
MERCHANT_PROXIMITY_KM=50
