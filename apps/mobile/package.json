{
  "name": "@civic/mobile",
  "main": "index.js",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start",
    "start:dev": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --dev-client",
    "start:tunnel": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --dev-client --tunnel",
    "start:lan": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --dev-client --lan",
    "start:ngrok": "bash scripts/start-ngrok.sh",
    "ngrok:tunnel": "bash scripts/ngrok-tunnel.sh",
    "android": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --android",
    "ios": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --ios",
    "ios:device": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo run:ios --device",
    "ios:pod-install": "cd ios && pod install",
    "ios:device:clean": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo prebuild --clean --platform ios && pnpm ios:pod-install && EXPO_NO_METRO_WORKSPACE_ROOT=1 expo run:ios --device",
    "android:prebuild": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo prebuild --platform android",
    "android:apk": "bash scripts/build-android-apk.sh",
    "web": "EXPO_NO_METRO_WORKSPACE_ROOT=1 expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@civic/shared": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "expo": "~54.0.36",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "^6.0.21",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~18.0.10",
    "expo-modules-core": "~3.0.29",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.0"
  }
}
