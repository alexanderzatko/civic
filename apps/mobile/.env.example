# Expo public vars (baked in at Metro start — restart after changes)
EXPO_PUBLIC_API_URL=https://civic-api.rovas.app
EXPO_PUBLIC_ROVAS_BASE_URL=https://dev.rovas.app
EXPO_PUBLIC_ROVAS_OAUTH_CLIENT_ID=civic

# Native Google Sign-In (dev build required). Web client id is required for
# idToken; iOS client id drives the reversed URL scheme in app.config.js.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=yyy.apps.googleusercontent.com
# Optional override if you cannot derive the scheme from the iOS client id:
# EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.yyy

# Facebook Login (browser AuthSession → Civic API). Same App ID as FACEBOOK_APP_ID.
# Redirect is fb{APP_ID}://authorize — add that exact URI in Meta → Facebook Login
# → Valid OAuth Redirect URIs. Rebuild after setting (app.config.js registers the scheme).
# EXPO_PUBLIC_FACEBOOK_APP_ID=

# Nabezky OIDC (PKCE). Secrets stay on Civic API (NABEZKY_CLIENT_SECRET).
# EXPO_PUBLIC_NABEZKY_BASE_URL=https://nabezky.sk
# EXPO_PUBLIC_NABEZKY_CLIENT_ID=

# OpenStreetMap OAuth2 (PKCE). Secret on Civic API (OSM_CLIENT_SECRET).
# EXPO_PUBLIC_OSM_CLIENT_ID=

# Legal / glossary pages (opened in the system browser from About + auth).
# Defaults: https://rovas.app/privacy and https://rovas.app/rules.
# Flip these when NeoFund n.f. publishes consolidated privacy / terms / glossary.
# EXPO_PUBLIC_LEGAL_PRIVACY_URL=https://rovas.app/privacy
# EXPO_PUBLIC_LEGAL_TERMS_URL=https://rovas.app/rules
# EXPO_PUBLIC_LEGAL_GLOSSARY_URL=https://rovas.app/rules
# Public Rovas marketing site for About (not OAuth):
# EXPO_PUBLIC_ROVAS_SITE_URL=https://rovas.app

# PostHog Cloud EU (product analytics). Leave key empty to disable.
# Create a project at https://eu.posthog.com — paste the project API key here
# and mirror both vars in EAS env for preview/production.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Static ngrok dev domain (ngrok dashboard → Domains).
# Used by: pnpm dev:mobile:ngrok + pnpm ngrok:tunnel
NGROK_STATIC_DOMAIN=your-name.ngrok-free.dev
EXPO_PACKAGER_PROXY_URL=https://your-name.ngrok-free.dev
