{
  "expo": {
    "name": "Civic",
    "slug": "civic",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "civic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.civic.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Civic potrebuje kameru na skenovanie QR kódu z eKasa bločka.",
        "NSLocationWhenInUseUsageDescription": "Civic používa polohu pri registrácii meritov z bločka (kontrola dôveryhodnosti).",
        "NSPhotoLibraryUsageDescription": "Civic používa fotky ako dôkaz dobrovoľníckej práce.",
        "NSPhotoLibraryAddUsageDescription": "Civic ukladá QR kód platby do galérie, aby ste ho mohli načítať v bankovej appke."
      }
    },
    "android": {
      "package": "app.civic.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "civic",
              "host": "oauth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Civic potrebuje kameru na skenovanie QR kódu z eKasa bločka."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Civic používa polohu pri registrácii meritov z bločka (kontrola dôveryhodnosti)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Civic používa fotky ako dôkaz dobrovoľníckej práce."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Civic používa fotky ako dôkaz dobrovoľníckej práce.",
          "savePhotosPermission": "Civic ukladá QR kód platby do galérie, aby ste ho mohli načítať v bankovej appke.",
          "granularPermissions": ["photo"]
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d69c9678-9853-435d-9ca6-8c3e52bafe4c"
      }
    }
  }
}
