{
  "expo": {
    "name": "Civic",
    "slug": "civic",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "civic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.civic.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Civic potrebuje kameru na skenovanie QR kódu z eKasa bločka.",
        "NSLocationWhenInUseUsageDescription": "Civic používa polohu pri registrácii meritov z bločka (kontrola dôveryhodnosti).",
        "NSPhotoLibraryUsageDescription": "Civic používa fotky ako dôkaz dobrovoľníckej práce.",
        "NSUserNotificationsUsageDescription": "Civic vás upozorní, keď máte overiť dobrovoľnícky výkaz."
      }
    },
    "android": {
      "package": "app.civic.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B3D2E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2E"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Civic potrebuje kameru na skenovanie QR kódu z eKasa bločka."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Civic používa polohu pri registrácii meritov z bločka (kontrola dôveryhodnosti)."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Civic používa fotky ako dôkaz dobrovoľníckej práce."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0B3D2E"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
