# Civic API
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/civic.sqlite

# Merit conversion fallback (net hourly wage) when Rovas national rate is unreachable.
# Live rate: GET {ROVAS}/rovas/civic_national_hourly_rate — see docs/rovas-integration.md.
HOURLY_WAGE_EUR=7.50
FORMULA_VERSION=1

# eKasa FS receipt lookup
EKASA_RECEIPT_FIND_URL=https://ekasa.financnasprava.sk/mdu/api/v1/opd/receipt/find

# Rovas
ROVAS_BASE_URL=https://dev.rovas.app
ROVAS_OAUTH_CLIENT_ID=civic
# ROVAS_OAUTH_CLIENT_SECRET=   # public client — leave empty for mobile PKCE

# Trusted Civic technical account (classic API-KEY + TOKEN) for
# POST /rovas/civic_auth_session — never EXPO_PUBLIC_*. See Rovas task
# civic-native-auth-bridge.
# ROVAS_API_KEY=
# ROVAS_TOKEN=

# Google / Apple ID-token audiences (comma-separated). Must include every
# OAuth client id whose tokens the mobile app can produce (web + iOS + Android).
# GOOGLE_CLIENT_IDS=xxx.apps.googleusercontent.com,yyy.apps.googleusercontent.com
# APPLE_CLIENT_IDS=app.civic.mobile

# Facebook (Meta) — Limited Login JWT aud + Graph debug_token.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Nabezky OAuth2/OIDC (authorization code + PKCE). Client secret stays here.
# NABEZKY_BASE_URL=https://nabezky.sk
# NABEZKY_CLIENT_ID=
# NABEZKY_CLIENT_SECRET=

# OpenStreetMap OAuth2 + pending JWT for in-app email collection.
# OSM_CLIENT_ID=
# OSM_CLIENT_SECRET=
# OSM_PENDING_JWT_SECRET=

# Fraud controls
# Always on: 3-strike block, purchase ≥ Rovas registration, min VAT.
MIN_VAT_EUR=0.01
STRIKE_THRESHOLD=3
STRIKE_WINDOW_DAYS=30
STRIKE_BLOCK_DAYS=7
CLAIM_RATE_LIMIT_DAY=20
CLAIM_RATE_LIMIT_MONTH=200

# Dev defaults OFF — turn ON for production (see README).
CLAIM_WINDOW_ENABLED=false
CLAIM_WINDOW_DAYS=1
SAME_STORE_DAILY_LIMIT_ENABLED=false
SAME_STORE_DAILY_LIMIT=2

# Volunteer work-report Civic app usage fee (deferred AUR on Rovas approval).
# Create the Civic project once in the Rovas UI (Merit allocation 100% to owner),
# then set CIVIC_APP_PROJECT_NID and enable the fee.
WR_USAGE_FEE_ENABLED=false
WR_USAGE_FEE_RATE=0.03
# CIVIC_APP_PROJECT_NID=
# ROVAS_PLATFORM_FEE_RATE=0.01

# Location heuristics deferred (unused; kept for older .env compatibility)
MAX_GROUND_SPEED_KMH=100
LOCATION_BUFFER_KM=25
MERCHANT_PROXIMITY_KM=50

# Mobile (Expo) — put these in apps/mobile/.env (see apps/mobile/.env.example).
# Root .env is loaded by the API; Expo loads apps/mobile/.env.
# Local Mac API: http://localhost:3001 or http://<LAN-IP>:3001
# VPS API: https://civic-api.rovas.app (see deploy/civic-api/deploy.sh)
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_ROVAS_BASE_URL=https://dev.rovas.app
EXPO_PUBLIC_ROVAS_OAUTH_CLIENT_ID=civic
# Static ngrok domain for pnpm dev:mobile:ngrok + pnpm ngrok:tunnel
# NGROK_STATIC_DOMAIN=your-name.ngrok-free.dev
